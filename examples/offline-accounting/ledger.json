      {
        "name": "libbar",
        "version": "4.5.6",
        "vulns": [
          {
            "id": "PYSEC-2024-0042",
            "fix_versions": ["4.5.7"],
            "description": "libbar deserializes untrusted data.",
            "aliases": ["CVE-2024-10042"]
          }
        ]
      }
    ],
    "fixes": []
  }
