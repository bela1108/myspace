n-        $green = \"green\" nocase\n+        $green   = \"green\" nocase\n         $emerald = \"emerald\" nocase\n         $success = \"success\" nocase\n+\n     condition:\n-        all of ($green, $emerald) and\n-        ($success or cn_has_notification_channel)\n+        any of ($green, $emerald)\n+        and ($success or cn_has_notification_channel)\n }\n \n rule ColorNotification_Blue {\n     strings:\n-        $blue = \"blue\" nocase\n+        $blue  = \"blue\" nocase\n         $azure = \"azure\" nocase\n-        $info = \"info\" nocase\n+        $info  = \"info\" nocase\n+\n     condition:\n-        1 of ($blue, $azure) and ($info or cn_has_notification_channel)\n+        2 of ($blue, $azure)\n+        and ($info or cn_has_notification_channel)\n }",
